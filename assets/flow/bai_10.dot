digraph CourseFlow {
graph [rankdir=TB, bgcolor="transparent", pad="0.25", ranksep="0.53", nodesep="0.40", splines=curved];
node [fontname="DejaVu Sans",fontsize=11, color="#08784d", fontcolor="#164b37", penwidth=1.6, style=filled, fillcolor="#eef7f0", margin="0.18,0.11"];
edge [fontname="DejaVu Sans",fontsize=10,color="#167954",fontcolor="#305e48",penwidth=1.5,arrowsize=0.75];
start [shape=ellipse, label="Bắt đầu", fillcolor="#d8efdf"];
inp [shape=parallelogram, label="Tạo đối tượng cảm biến", fillcolor="#fff7d8"];
end [shape=ellipse, label="Kết thúc",fillcolor="#d8efdf"];
p [shape=box,label="Gọi is_alert(ngưỡng)",fillcolor="#eef7f0"];
d [shape=diamond,label="T > ngưỡng?",fillcolor="#fff3cc"];
yes [shape=parallelogram,label="Trả về True",fillcolor="#e4f2ed"];
no [shape=parallelogram,label="Trả về False",fillcolor="#e4f2ed"];
start -> inp [minlen=1];
inp -> p [minlen=1];
p -> d [minlen=1];
d -> yes [label="Có",minlen=1];
d -> no [label="Không",minlen=1];
yes -> end [minlen=1];
no -> end [minlen=1];
}