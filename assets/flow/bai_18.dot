digraph CourseFlow {
graph [rankdir=TB, bgcolor="transparent", pad="0.25", ranksep="0.53", nodesep="0.40", splines=curved];
node [fontname="DejaVu Sans",fontsize=11, color="#08784d", fontcolor="#164b37", penwidth=1.6, style=filled, fillcolor="#eef7f0", margin="0.18,0.11"];
edge [fontname="DejaVu Sans",fontsize=10,color="#167954",fontcolor="#305e48",penwidth=1.5,arrowsize=0.75];
start [shape=ellipse, label="Bắt đầu", fillcolor="#d8efdf"];
inp [shape=parallelogram, label="Nhận danh sách bản tin", fillcolor="#fff7d8"];
end [shape=ellipse, label="Kết thúc",fillcolor="#d8efdf"];
more [shape=diamond,label="Còn bản tin?",fillcolor="#fff3cc"];
check [shape=diamond,label="Timestamp và số hợp lệ?",fillcolor="#fff3cc"];
good [shape=box,label="Lưu bản ghi tốt",fillcolor="#eef7f0"];
bad [shape=box,label="Tăng bộ đếm lỗi",fillcolor="#eef7f0"];
out [shape=parallelogram,label="Ghi CSV, báo số mẫu",fillcolor="#e4f2ed"];
start -> inp [minlen=1];
inp -> more [minlen=1];
more -> check [label="Có",minlen=1];
check -> good [label="Đúng",minlen=1];
check -> bad [label="Sai",minlen=1];
good -> more [constraint=false,style=dashed,tailport=w,headport=w,minlen=1];
bad -> more [constraint=false,style=dashed,tailport=w,headport=w,minlen=1];
more -> out [label="Không",minlen=1];
out -> end [minlen=1];
}