digraph CourseFlow {
graph [rankdir=TB, bgcolor="transparent", pad="0.25", ranksep="0.53", nodesep="0.40", splines=curved];
node [fontname="DejaVu Sans",fontsize=11, color="#08784d", fontcolor="#164b37", penwidth=1.6, style=filled, fillcolor="#eef7f0", margin="0.18,0.11"];
edge [fontname="DejaVu Sans",fontsize=10,color="#167954",fontcolor="#305e48",penwidth=1.5,arrowsize=0.75];
start [shape=ellipse, label="Bắt đầu", fillcolor="#d8efdf"];
inp [shape=parallelogram, label="Nhận P, t", fillcolor="#fff7d8"];
end [shape=ellipse, label="Kết thúc",fillcolor="#d8efdf"];
valid [shape=diamond,label="P ≥ 0 và t ≥ 0 ?",fillcolor="#fff3cc"];
err [shape=parallelogram,label="Báo ValueError",fillcolor="#e4f2ed"];
p [shape=box,label="E ← P × t",fillcolor="#eef7f0"];
out [shape=parallelogram,label="Trả về E kWh",fillcolor="#e4f2ed"];
start -> inp [minlen=1];
inp -> valid [minlen=1];
valid -> err [label="Không",minlen=1];
valid -> p [label="Có",minlen=1];
p -> out [minlen=1];
out -> end [minlen=1];
err -> end [minlen=1];
}